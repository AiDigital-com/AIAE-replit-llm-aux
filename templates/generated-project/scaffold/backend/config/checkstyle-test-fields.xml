<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Narrow test-source contract. JUnit Jupiter recommends package-private test
  classes and methods, so the production Checkstyle profile intentionally does
  not run over tests. Test instance fields are different: implicit
  package-private state leaks across package peers and makes fixture ownership
  unclear. This profile checks only field visibility and leaves JUnit
  class/method visibility untouched.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <module name="VisibilityModifier">
            <property name="protectedAllowed" value="false"/>
        </module>
    </module>
</module>
