<?xml version="1.0" encoding="UTF-8"?>
<!--
  Self-contained event-logging-to-db-feature module. Owns the full usage-
  logging Java surface: @LogUsage, UsageAttributes, UsageEvent, UsageLogger,
  the aspect, configs, JPA entity + repository. `service` depends on this
  module so *ServiceImpl classes can carry @LogUsage; `application` picks
  it up transitively through the service edge.

  Database migrations live in the `migrations` module — NOT here. Migrations are
  intentionally single-sourced: `backend/migrations/src/main/resources/db/changelog/`
  is the ONE place Liquibase changelogs sit, regardless of which feature
  module owns the corresponding @Entity. Splitting changelogs across modules
  hides the table-creation contract from the migration owner and makes
  cross-module Liquibase classpath includes a long-term footgun.

  Removal flow (in order):
    - Lightweight kill (no recompile): set `app.usage-logging.enabled=false`
      → aspect + PostgresUsageLogger drop out, NoOpUsageLogger binds, table
      stays.
    - Full removal: drop <module>event-logging-to-db-feature</module> from
      backend/pom.xml, drop the dependency line from service/pom.xml, delete
      every @LogUsage import + usage from *ServiceImpl, and remove the
      <include file="db/changelog/changes/0001-usage-events.xml"/> line from
      migrations/src/main/resources/db/changelog/db.changelog-master.xml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>PACKAGE_REPLACE_ME</groupId>
        <artifactId>app-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>event-logging-to-db-feature</artifactId>
    <name>Replit MVP — event-logging-to-db-feature</name>

    <!-- Self-contained, removable feature. Must NOT depend on any other internal
         module (domain/service/application). ID semantics live in this module. -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Direct compile dependencies: this removable module owns JPA,
             AOP, web-request extraction, configuration, and security types.
             Keep framework starters in application/, not this library module. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- Test-only direct dependencies. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
